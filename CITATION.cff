cff-version: 1.2.0
message: "If you use these code lists in your research, please cite this repository and the original papers listed under references."
title: "patent-codes-for-research: machine-readable green patent classification codes"
type: dataset
version: 0.1.0
date-released: 2026-11-02
license: MIT
repository-code: "https://github.com/davidjaggi/patent-codes-for-research"
authors:
  - family-names: Jaggi
    given-names: David
    affiliation: "ZHAW"
keywords: [patents, CPC, IPC, Y02, green innovation, sustainable finance]
references:
  - type: report
    title: "Measuring environmental innovation using patent data"
    authors: [{family-names: Haščič, given-names: Ivan}, {family-names: Migotto, given-names: Mauro}]
    year: 2015
    institution: {name: OECD}
    notes: "OECD Environment Working Papers No. 89 (ENV-TECH)"
    doi: 10.1787/5js009kf48xw-en
  - type: article
    title: "Pivoting from Dirty to Clean: The Intellectual Distance between Clean and Dirty Technologies"
    authors: [{family-names: Jee, given-names: Seung Jin}, {family-names: Srivastav, given-names: Sugandha}]
    year: 2023
  - type: unpublished
    title: "Market Power, Innovation, and the Green Transition"
    authors: [{family-names: Rozendaal, given-names: Rik}]
    year: 2024
    notes: "Table E1 reproduces the Jee & Srivastav code lists"
  - type: article
    title: "Green patents and green codes: how different methodologies lead to different results"
    authors:
      - {family-names: Favot, given-names: Marinella}
      - {family-names: Vesnic, given-names: Leyla}
      - {family-names: Priore, given-names: Riccardo}
      - {family-names: Bincoletto, given-names: Andrea}
      - {family-names: Morea, given-names: Fabio}
    year: 2023
    journal: "Resources, Conservation & Recycling Advances"
    volume: "200132"
    doi: 10.1016/j.rcradv.2023.200132
    notes: "IPC Green Inventory and expanded ENV-TECH lists (CC-BY-4.0): https://gitlab.com/area-science-park-sustainability/green-patents"
  - type: dataset
    title: "IPC Green Inventory"
    institution: {name: "World Intellectual Property Organization (WIPO)"}
    url: "https://www.wipo.int/classifications/ipc/green-inventory/home"
